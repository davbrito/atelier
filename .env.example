# Database connection URL
# Example (Postgres): postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Unpooled database connection URL (for serverless/Prisma migrations)
# Usually the same as DATABASE_URL but with ?pgbouncer=true or connection_limit=1
DATABASE_URL_UNPOOLED=

# Better Auth secret (required) — used for encryption and hashing
# Must be at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Better Auth base URL (required) — base URL of your app
# For local development: http://localhost:3000
BETTER_AUTH_URL=

# Google OAuth credentials (required)
# Create a project at https://console.cloud.google.com/apis/credentials
PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of whitelisted emails with access to the app
# Example: WHITELISTED_EMAILS=user1@gmail.com,user2@gmail.com
WHITELISTED_EMAILS=

# ── S3-compatible storage (Cloudflare R2) ──────────────────
# Endpoint URL including bucket path for uploads
# Example (R2): https://<account_id>.r2.cloudflarestorage.com/<bucket>
STORAGE_URL=

# S3 access credentials
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Region (use "auto" for Cloudflare R2, or "us-east-1" for AWS S3)
STORAGE_REGION=auto

#
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=