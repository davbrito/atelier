{
  "name": "atelier",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "pnpm run build && vite preview",
    "test": "vitest run",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "auth:generate": "auth generate --config ./src/lib/auth/config.ts --output ./src/db/auth.gen.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "DOTENV_CONFIG_PATH=\".env.production\" node --run db:migrate",
    "generate-routes": "tsr generate",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth-ui/core": "catalog:auth",
    "@better-auth-ui/react": "catalog:auth",
    "@better-auth/drizzle-adapter": "catalog:auth",
    "@better-auth/passkey": "catalog:auth",
    "@fontsource-variable/bodoni-moda": "^5.2.7",
    "@fontsource-variable/figtree": "^5.2.10",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@sindresorhus/slugify": "^3.0.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.168.19",
    "@uiw/react-color": "^2.10.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.7.5",
    "aws4fetch": "^1.0.20",
    "better-auth": "catalog:auth",
    "bowser": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cnfast": "^0.0.8",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:drizzle",
    "lucide-react": "^1.24.0",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.81.0",
    "react-number-format": "^5.4.5",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@cloudflare/vite-plugin": "^1.44.0",
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "auth": "catalog:auth",
    "drizzle-kit": "catalog:drizzle",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.0",
    "typescript": "7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
