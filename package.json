{
  "name": "atelier",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "pnpm run build && vite preview",
    "test": "vitest run",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "auth:generate": "auth generate --config ./src/lib/auth/config.ts --output ./src/db/auth.gen.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "DOTENV_CONFIG_PATH=\".env.production\" node --run db:migrate",
    "generate-routes": "tsr generate",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "knip": "knip"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth-ui/core": "catalog:auth",
    "@better-auth-ui/react": "catalog:auth",
    "@better-auth/drizzle-adapter": "catalog:auth",
    "@better-auth/passkey": "catalog:auth",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@sindresorhus/slugify": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "^1.170.21",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.38",
    "@tanstack/router-plugin": "^1.168.26",
    "@uiw/react-color": "^2.10.3",
    "aws4fetch": "^1.0.20",
    "better-auth": "catalog:auth",
    "bowser": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cnfast": "^0.1.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:drizzle",
    "lucide-react": "^1.29.0",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.0.0",
    "react-hook-form": "^7.84.0",
    "react-number-format": "^5.4.5",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@cloudflare/vite-plugin": "^1.51.0",
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
