{
  "name": "atelier",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "pnpm run build && vite preview",
    "test": "vitest run",
    "format": "biome format --write src",
    "lint": "biome lint src",
    "check": "biome check src",
    "typecheck": "tsc --noEmit",
    "auth:generate": "auth generate --config ./src/lib/auth/config.ts --output ./src/db/auth.gen.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "DOTENV_CONFIG_PATH=\".env.production\" node --run db:migrate",
    "generate-routes": "tsr generate",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth-ui/core": "catalog:auth",
    "@better-auth-ui/react": "catalog:auth",
    "@better-auth/drizzle-adapter": "catalog:auth",
    "@better-auth/passkey": "catalog:auth",
    "@fontsource-variable/bodoni-moda": "^5.2.7",
    "@fontsource-variable/figtree": "^5.2.10",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@sindresorhus/slugify": "^3.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.168.18",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.7.4",
    "aws4fetch": "^1.0.20",
    "better-auth": "catalog:auth",
    "bowser": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cnfast": "^0.0.8",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:drizzle",
    "lucide-react": "^1.21.0",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.80.0",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "unstorage": "^1.17.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@cloudflare/vite-plugin": "^1.42.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "auth": "catalog:auth",
    "drizzle-kit": "catalog:drizzle",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.4",
    "typescript": "7.0.1-rc",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
